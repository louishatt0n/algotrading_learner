   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "np.random.seed(42)\n",
    "prices = 100 + np.cumsum(np.random.randn(252)*0.5)\n",
    "df = pd.DataFrame({'Price': prices}, index=pd.date_range(start='2024-01-01', periods=252))\n",
    "\n",
    "df.plot(title=\"Simulated BTC Price\", figsize=(10, 6))\n"
   ]
  },
